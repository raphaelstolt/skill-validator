{
    "name": "stolt/skill-validator",
    "description": "A library for parsing and validating SKILL.md files or raw SKILL.md content.",
    "keywords": [
        "php",
        "ai",
        "parse",
        "parsing",
        "validate",
        "validating",
        "skills",
        "skills directory",
        "agent-skills",
        "SKILL.md",
        "file",
        "content"
    ],
    "authors": [
        {
            "name": "Raphael Stolt",
            "email": "raphael.stolt@gmail.com"
        }
    ],
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Stolt\\Ai\\Skill\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "stolt/skill-md": "^0.0.3"
    },
    "suggest": {
        "stolt/list-skills-command": "Allows introspection of SKILL.md files from the console."
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
